API_PORT=8003
WEB_PORT=5182
CMS_PORT=5181
# Caddy (~/Caddyfile) fronts these ports as https://7magic.localhost,
# https://cms.7magic.localhost and https://api.7magic.localhost.
# Browser-side API calls use this; it must be https or the https page blocks
# them as mixed content. Set it to http://127.0.0.1:8003 when running an app
# directly on its port without the proxy.
PUBLIC_API_BASE_URL=https://api.7magic.localhost
# Server-side (SSR) API calls use this instead: Node cannot resolve a
# *.localhost subdomain, so it has to reach the API on the loopback port.
PUBLIC_API_INTERNAL_URL=http://127.0.0.1:8003
DATABASE_URL=sqlite+aiosqlite:///./7magic.db
SESSION_TTL_SECONDS=1209600
# Hard cap on total session age (30 days); sliding refresh never extends past it.
SESSION_MAX_LIFETIME_SECONDS=2592000
# Failed login attempts allowed per IP+email within the window before a 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Shared secret for website venue reads. Set the same value for the API and the
# web app; leave empty to keep the venue endpoints open.
VENUE_READ_API_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=7magic-venue-photos
R2_PUBLIC_BASE_URL=https://cdn.example.com
# Same bucket host, needed by the web app for the one set of objects the API
# does not return a URL for (the partner logo strip). Keep it in step with
# R2_PUBLIC_BASE_URL above.
PUBLIC_MEDIA_BASE_URL=https://cdn.example.com

# Transactional email (Resend). Leads are always saved to the database;
# without a key the API logs a warning instead of sending a notification.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=info@7magicwedding.com
# Must be a domain verified in Resend before real sends will work.
LEAD_NOTIFICATION_FROM="7Magic Website <noreply@7magicwedding.com>"

# Plausible analytics. Public by nature: the script URL is rendered into the
# page, and it carries the site id. Leave it unset in dev/preview — nothing is
# injected while it is empty, so local traffic never reaches production stats.
PUBLIC_PLAUSIBLE_SRC=
