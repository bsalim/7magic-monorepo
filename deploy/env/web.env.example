# Copy to apps/web/.env on the server, then: chmod 600.

PORT=6273
HOST=127.0.0.1

# Required by adapter-node behind a reverse proxy. Without it, form actions
# fail with "Cross-site POST form submissions are forbidden".
ORIGIN=https://7magicwedding.com

# Browser-facing API origin. Must be https — an http call from an https page is
# blocked as mixed content.
PUBLIC_API_BASE_URL=https://api.7magicwedding.com

# SSR reaches the API over loopback, skipping TLS and public DNS.
PUBLIC_API_INTERNAL_URL=http://127.0.0.1:8003

# R2 bucket host. The API returns absolute URLs for everything it owns; this is
# only for the partner logo strip, which builds its own. Must match
# R2_PUBLIC_BASE_URL in api.env or those logos 404 while every other image works.
PUBLIC_MEDIA_BASE_URL=https://media.7magicwedding.com

# Must match VENUE_READ_API_KEY in api.env.
VENUE_READ_API_KEY=

# Plausible. The script tag only renders when the domain is set, so leaving
# this empty on staging keeps preview traffic out of production stats.
PUBLIC_PLAUSIBLE_DOMAIN=7magicwedding.com
# Only for self-hosted Plausible or a proxied script path; defaults to
# https://plausible.io/js/script.js when empty.
PUBLIC_PLAUSIBLE_SRC=

# Trust X-Forwarded-* so client IP and protocol are correct. Only safe because
# Caddy is the sole ingress and binds these services to loopback.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
