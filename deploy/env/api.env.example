# Copy to apps/api/.env on the server, then: chmod 600.
# systemd parses this as literal KEY=VALUE — do NOT quote values or use $VAR.

API_PORT=8003
API_WORKERS=4

# Postgres. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/sevenmagic

SESSION_TTL_SECONDS=1209600
SESSION_MAX_LIFETIME_SECONDS=2592000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Shared secret guarding the website venue reads. Must match the identical
# value in web.env — if they diverge, every venue detail page 404s.
VENUE_READ_API_KEY=

# Cloudflare R2 — venue and article images.
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=7magic-venue-photos
R2_PUBLIC_BASE_URL=https://media.7magicwedding.com
