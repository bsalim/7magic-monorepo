# Copy to apps/api/.env on the server, then: chmod 600.
# systemd parses this as literal KEY=VALUE — do NOT quote values or use $VAR.

API_PORT=8003
API_WORKERS=4

# Postgres. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/sevenmagic

SESSION_TTL_SECONDS=1209600
SESSION_MAX_LIFETIME_SECONDS=2592000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Shared secret guarding the website venue reads. Must match the identical
# value in web.env — if they diverge, every venue detail page 404s.
VENUE_READ_API_KEY=

# Cloudflare R2 — venue and article images.
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=7magic-venue-photos
R2_PUBLIC_BASE_URL=https://media.7magicwedding.com

# Bird — WhatsApp alerts, and optionally transactional email (see MAIL_PROVIDER).
#
# This is Bird's newer developer API (bird.com/docs), not the older Channels API
# on docs.bird.com. The bk_ key identifies the sending number by itself, so there
# is no workspace or channel UUID to configure here.
BIRD_API_KEY=bk_
# Shown once when the webhook is created — not the API key.
BIRD_WEBHOOK_SIGNING_KEY=
# Where lead alerts are sent, E.164. Unset means no alert is attempted at all.
WHATSAPP_TEAM_NUMBER=
# An approved `utility` template with four body slots, in order:
# name, contact, page, message. Bird accepts nothing but templates, so a slug
# that is not approved makes every alert fail with WhatsAppTemplateNotFound.
#
# SLOTS must match what the template declares or the send is rejected with
# WhatsAppTemplateParameterMismatch. Fewer slots than four is supported: the
# fields merge from the right, so the name stays legible on its own.
#
# Stopgap until a custom template exists — Bird's system templates are English
# and their wording is wrong for this ("your order is out for delivery"), so
# treat it as a bridge of days, not weeks:
#   BIRD_LEAD_TEMPLATE=bird_booking_confirmation
#   BIRD_LEAD_TEMPLATE_LANGUAGE=en
#   BIRD_LEAD_TEMPLATE_SLOTS=2
#   BIRD_LEAD_TEMPLATE_PARAMS=count,date
#
# PARAMS names the slots, in order, for a template that declares named parameters
# ("Your reservation for {{count}} on {{date}}"). Every Bird system template is
# named, and sending one of those positionally is rejected as E15003 — which is
# how every alert failed silently until it was caught. Leave PARAMS empty for a
# purpose-built template with positional slots; a name it never declared is
# rejected just as hard as a missing one.
BIRD_LEAD_TEMPLATE=lead_alert
BIRD_LEAD_TEMPLATE_LANGUAGE=id
BIRD_LEAD_TEMPLATE_SLOTS=4
BIRD_LEAD_TEMPLATE_PARAMS=

# --- Transactional email ------------------------------------------------------
# Which provider sends. "resend" (default) or "bird". Both can stay configured;
# this picks one, so switching back is this variable and a restart.
#
# Keep it on resend until the sending domain is verified in Bird (DKIM, SPF and
# a return-path CNAME). Without that, Bird can only send from its sandbox
# address, so a guest's booking confirmation arrives from messagebird.dev.
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Bird's mail key. Separate from BIRD_API_KEY so it can be rotated or scoped
# without touching WhatsApp. The region host is derived from the bk_{region}_
# prefix, so there is no base URL, no workspace id and no channel id to set.
#
# It falls back to BIRD_API_KEY only when this line is ABSENT. Left present and
# empty, as below, it means "no mail key" and Bird sends nothing -- delete the
# line to share the WhatsApp key instead.
BIRD_MAIL_API_KEY=
# Bird files an unset send as "marketing". A booking confirmation is not that,
# and the bucket changes how it is filtered and what unsubscribe handling applies.
BIRD_MAIL_CATEGORY=transactional
# The From on every transactional email, RFC 5322. Both providers accept this
# same form. The domain must be one the chosen provider has verified.
LEAD_NOTIFICATION_FROM=7Magic Wedding <hello@7magicwedding.com>
# Where lead notifications land.
LEAD_NOTIFICATION_EMAIL=info@7magicwedding.com
# Absolute https URL for the email header logo. Blank renders a text wordmark,
# which is also what the many readers who block remote images see -- so blank is
# a valid choice, not a broken one.
# Upload with: uv run python scripts/upload_email_logo.py
EMAIL_LOGO_URL=
