# Copy to apps/cms/.env on the server, then: chmod 600.

PORT=6173
HOST=127.0.0.1

# Must match the public CMS host exactly. The CMS stores the admin session in
# an httpOnly cookie, and a mismatched ORIGIN makes every login look cross-site
# and get rejected.
ORIGIN=https://cms.7magicwedding.com

PUBLIC_API_BASE_URL=https://api.7magicwedding.com
PUBLIC_API_INTERNAL_URL=http://127.0.0.1:8003

PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
